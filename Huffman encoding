import java.util.Scanner;
import java.util.ArrayList;
import java.util.HashMap;

class Node {
    int freq;
    char c;
    Node left, right;
}

public class Huffman {
    static HashMap<Character, String> huffmanCodes = new HashMap<>();

    public static void sortNodes(ArrayList<Node> nodes) {
        for (int i = 0; i < nodes.size(); i++) {
            int minIdx = i;
            for (int j = i + 1; j < nodes.size(); j++) {
                if (nodes.get(j).freq < nodes.get(minIdx).freq) {
                    minIdx = j;
                }
            }
            Node temp = nodes.get(i);
            nodes.set(i, nodes.get(minIdx));
            nodes.set(minIdx, temp);
        }
    }

    public static void generateCodes(Node root, String s) {
        if (root == null) return;
        if (root.left == null && root.right == null) {
            huffmanCodes.put(root.c, s);
            return;
        }
        generateCodes(root.left, s + "0");
        generateCodes(root.right, s + "1");
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        ArrayList<Node> nodes = new ArrayList<>();

        System.out.print("Enter the number of symbols: ");
        int n = sc.nextInt();

        for (int i = 0; i < n; i++) {
            Node newNode = new Node();
            System.out.print("Enter symbol " + (i + 1) + ": ");
            newNode.c = sc.next().charAt(0);
            System.out.print("Enter frequency for " + newNode.c + ": ");
            newNode.freq = sc.nextInt();
            nodes.add(newNode);
        }

        while (nodes.size() > 1) {
            sortNodes(nodes);
            Node left = nodes.remove(0);
            Node right = nodes.remove(0);
            Node parent = new Node();
            parent.freq = left.freq + right.freq;
            parent.c = '-';
            parent.left = left;
            parent.right = right;
            nodes.add(parent);
        }

        if (!nodes.isEmpty()) {
            generateCodes(nodes.get(0), "");
        }

        System.out.println("\nGenerated Huffman Codes: " + huffmanCodes + "\n");
        System.out.print("\nEnter the string to encode: ");
        String input = sc.next();
        StringBuilder encodedString = new StringBuilder();

        for (char ch : input.toCharArray()) {
            if (huffmanCodes.containsKey(ch)) {
                encodedString.append(huffmanCodes.get(ch));
            } else {
                System.out.println("Character '" + ch + "' has no assigned code.");
            }
        }

        System.out.println("Encoded String: " + encodedString.toString());
    }
}
