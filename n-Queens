
public class nqueens{
    static int[] x;
    public static boolean place(int k, int i) {
        for (int j = 1; j < k; j++){
            if (x[j] == i || Math.abs(x[j] - i) == Math.abs(j - k)) {
                return false;
            }
        }
        return true;
    }
    public static void nQueens(int k, int n) {
        for (int i = 1; i <= n; i++) {
            if (place(k, i)) {
                x[k]=i;
                if (k == n) {
                    printBoard(n);
                } else {
                    nQueens(k + 1, n);
                }
            }
        }
    }
    public static void printBoard(int n) {
        System.out.println("Solution found: \n");
        System.out.println("Array: ");
        for(int i=0;i<=n;i++){
           System.out.print(x[i]+" ");
        }
        System.out.println("\n");
        for (int i = 1; i <= n; i++) {
            for (int j = 1; j <= n; j++) {
                if (x[i] == j) System.out.print(" Q ");
                else System.out.print(" . ");
            }
            System.out.println();
        }
        System.out.println();
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter number of Queens (N): ");
        int n = sc.nextInt();
        x = new int[n + 1];
        nQueens(1, n);
    }
}
